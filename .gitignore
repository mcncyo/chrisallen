# Hugo build output
/public/
/resources/_gen/
/hugo_stats.json

# OS files
.DS_Store
Thumbs.db

# Backup files
*.bak
*.swp
*.swo
*~

# Node/npm stuff (if used for custom JS or themes)
node_modules/
package-lock.json

# VSCode/IDE config (optional)
.vscode/
.idea/

# Logs
*.log

# Themes (if using submodules, you usually don’t want to ignore this)
# themes/

# Git submodule working dirs (optional if needed)
.git/modules/

# Optional: ignore the build lock
.hugo_build.lock

